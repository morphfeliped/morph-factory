# Copie para .env (o .env nunca vai para o git).
# Com DRY_RUN=true nada sai da máquina: o MCP grava em saida-simulada/ o que enviaria.
DRY_RUN=true

# n8n (API pública: Settings → n8n API → Create API key)
N8N_URL=https://seu-n8n.exemplo.com
N8N_API_KEY=

# Meta / WhatsApp Cloud API (token de System User do Business Manager da Morph)
META_TOKEN=
META_GRAPH_VERSION=v21.0
