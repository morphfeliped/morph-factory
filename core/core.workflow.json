{
  "name": "morph.core",
  "nodes": [
    {
      "id": "core-1",
      "name": "Webhook Meta",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "morph-core-whatsapp",
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "core-2",
      "name": "Extrair mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 300],
      "parameters": {
        "jsCode": "// Normaliza o payload do webhook da WhatsApp Cloud API\nconst valor = $json.body.entry?.[0]?.changes?.[0]?.value ?? {};\nconst msg = valor.messages?.[0];\nif (!msg) return []; // status de entrega, leitura etc. são ignorados\nreturn [{ json: {\n  telefone: msg.from,\n  texto: msg.text?.body ?? '[mensagem não textual]',\n  nome_contato: valor.contacts?.[0]?.profile?.name ?? '',\n  phone_number_id: valor.metadata?.phone_number_id\n} }];"
      }
    },
    {
      "id": "core-3",
      "name": "Config do cliente",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [440, 300],
      "notes": "Preenchido por criar_cliente: cliente_id, vertical, prompt_template, variaveis, telefone_humano.",
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": { "assignments": [] },
        "options": {}
      }
    },
    {
      "id": "core-4",
      "name": "Montar prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 300],
      "parameters": {
        "jsCode": "// Substitui {{variavel}} do prompt do vertical (contrato-core §5)\nconst cfg = $json;\nconst vars = {\n  ...(typeof cfg.variaveis === 'string' ? JSON.parse(cfg.variaveis) : cfg.variaveis),\n  data_hoje: new Date().toLocaleDateString('pt-BR'),\n  nome_contato: cfg.nome_contato || 'cliente'\n};\nconst system_prompt = cfg.prompt_template.replace(/\\{\\{\\s*(\\w+)\\s*\\}\\}/g, (_, k) => vars[k] ?? '');\nreturn [{ json: { ...cfg, system_prompt } }];"
      }
    },
    {
      "id": "core-5",
      "name": "Agente IA",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [900, 300],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.texto }}",
        "options": { "systemMessage": "={{ $json.system_prompt }}" }
      }
    },
    {
      "id": "core-6",
      "name": "Modelo LLM",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [820, 520],
      "parameters": {
        "model": "claude-haiku-5-5",
        "options": { "maxTokensToSample": 600, "temperature": 0.3 }
      }
    },
    {
      "id": "core-7",
      "name": "Histórico",
      "type": "@n8n/n8n-nodes-langchain.memoryPostgresChat",
      "typeVersion": 1.3,
      "position": [1000, 520],
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Config do cliente').item.json.cliente_id }}:{{ $('Extrair mensagem').item.json.telefone }}",
        "tableName": "morph_historico",
        "contextWindowLength": 12
      }
    },
    {
      "id": "core-8",
      "name": "Transbordo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1140, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "combinator": "and",
          "conditions": [
            {
              "id": "cond-transbordo",
              "leftValue": "={{ $json.output }}",
              "rightValue": "[TRANSBORDO]",
              "operator": { "type": "string", "operation": "contains" }
            }
          ]
        }
      }
    },
    {
      "id": "core-9",
      "name": "Avisar atendente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1380, 180],
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $('Extrair mensagem').item.json.phone_number_id }}/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "whatsAppApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"messaging_product\": \"whatsapp\", \"to\": \"{{ $('Config do cliente').item.json.telefone_humano }}\", \"type\": \"text\", \"text\": { \"body\": \"Transbordo: {{ $('Extrair mensagem').item.json.nome_contato }} ({{ $('Extrair mensagem').item.json.telefone }}) pediu atendimento humano.\" } }"
      }
    },
    {
      "id": "core-10",
      "name": "Enviar resposta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1380, 420],
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $('Extrair mensagem').item.json.phone_number_id }}/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "whatsAppApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"messaging_product\": \"whatsapp\", \"to\": \"{{ $('Extrair mensagem').item.json.telefone }}\", \"type\": \"text\", \"text\": { \"body\": {{ JSON.stringify($json.output) }} } }"
      }
    }
  ],
  "connections": {
    "Webhook Meta": { "main": [[{ "node": "Extrair mensagem", "type": "main", "index": 0 }]] },
    "Extrair mensagem": { "main": [[{ "node": "Config do cliente", "type": "main", "index": 0 }]] },
    "Config do cliente": { "main": [[{ "node": "Montar prompt", "type": "main", "index": 0 }]] },
    "Montar prompt": { "main": [[{ "node": "Agente IA", "type": "main", "index": 0 }]] },
    "Modelo LLM": { "ai_languageModel": [[{ "node": "Agente IA", "type": "ai_languageModel", "index": 0 }]] },
    "Histórico": { "ai_memory": [[{ "node": "Agente IA", "type": "ai_memory", "index": 0 }]] },
    "Agente IA": { "main": [[{ "node": "Transbordo?", "type": "main", "index": 0 }]] },
    "Transbordo?": {
      "main": [
        [{ "node": "Avisar atendente", "type": "main", "index": 0 }],
        [{ "node": "Enviar resposta", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" }
}
