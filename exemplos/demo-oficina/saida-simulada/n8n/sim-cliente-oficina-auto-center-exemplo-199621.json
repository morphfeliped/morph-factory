          "typeVersion": 3.4,
          "position": [
            440,
            300
          ],
          "notes": "Preenchido por criar_cliente: cliente_id, vertical, prompt_template, variaveis, telefone_humano.",
          "parameters": {
            "mode": "manual",
            "includeOtherFields": true,
            "assignments": {
              "assignments": [
                {
                  "id": "cfg-1",
