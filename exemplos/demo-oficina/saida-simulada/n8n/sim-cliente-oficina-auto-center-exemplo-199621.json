          "parameters": {
            "jsCode": "// Substitui {{variavel}} do prompt do vertical (contrato-core §5)\nconst cfg = $json;\nconst vars = {\n  ...(typeof cfg.variaveis === 'string' ? JSON.parse(cfg.variaveis) : cfg.variaveis),\n  data_hoje: new Date().toLocaleDateString('pt-BR'),\n  nome_contato: cfg.nome_contato || 'cliente'\n};\nconst system_prompt = cfg.prompt_template.replace(/\\{\\{\\s*(\\w+)\\s*\\}\\}/g, (_, k) => vars[k] ?? '');\nreturn [{ json: { ...cfg, system_prompt } }];"
          }
