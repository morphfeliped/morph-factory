            "jsCode": "const entrada = $('Validar args').item.json;\nif (entrada.invalido) {\n  const texto = entrada.motivo === 'placa_invalida'\n    ? 'Não entendi a placa. Pode mandar de novo?'\n    : 'Me passa o número da OS ou a placa do carro?';\n  return [{ json: { texto, dados: { erro: entrada.motivo } } }];\n}\nif ($json.erro) {\n  const texto = $json.erro === 'nao_encontrado'\n    ? 'Não achei essa OS. Confere o número ou a placa?'\n    : 'Não consegui consultar agora. Quer que eu chame um atendente?';\n  return [{ json: { texto, dados: { erro: $json.erro } } }];\n}\nconst nomes = {\n  aguardando_diagnostico: 'aguardando diagnóstico',\n  aguardando_aprovacao: 'aguardando aprovação do orçamento',\n  aguardando_peca: 'aguardando peça',\n  em_execucao: 'em execução',\n  pronto_retirada: 'pronto para retirada'\n};\nconst status = $json.status ?? '';\nlet texto = `OS ${$json.numero_os ?? entrada.numero_os}: ${nomes[status] ?? status}.`;\nif ($json.previsao_confirmada) texto += ` Previsão confirmada: ${$json.previsao_confirmada}.`;\nreturn [{ json: { texto, dados: { numero_os: $json.numero_os ?? entrada.numero_os, placa: $json.placa ?? entrada.placa, status, previsao_confirmada: $json.previsao_confirmada ?? null } } }];"
