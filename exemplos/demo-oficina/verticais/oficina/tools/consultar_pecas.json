{
  "name": "morph.oficina.consultar_pecas",
  "nodes": [
    {
      "id": "t1",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "jsonExample",
        "jsonExample": "{\n  \"cliente_id\": \"oficina-auto-center-exemplo\",\n  \"telefone\": \"5519999990000\",\n  \"args\": { \"peca\": \"pastilha de freio\", \"veiculo\": \"Onix 2019\" }\n}"
      }
    },
    {
      "id": "t2",
      "name": "Validar args",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const { cliente_id, args = {} } = $json;\nconst peca = String(args.peca ?? '').trim();\nconst veiculo = String(args.veiculo ?? '').trim();\nif (!peca) return [{ json: { invalido: true, motivo: 'peca_obrigatoria' } }];\nreturn [{ json: { cliente_id, peca, veiculo } }];"
      }
    },
    {
      "id": "t-if",
      "name": "Args ok?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "args-ok",
              "leftValue": "={{ $json.invalido }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "notTrue",
                "singleValue": true
              }
            }
          ]
        }
      }
    },
    {
      "id": "t3",
      "name": "Buscar estoque",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.MORPH_API_URL }}/clientes/{{ $json.cliente_id }}/estoque/pecas",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "peca",
              "value": "={{ $json.peca }}"
            },
            {
              "name": "veiculo",
              "value": "={{ $json.veiculo }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "t4",
      "name": "Retorno",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "const entrada = $('Validar args').item.json;\nif (entrada.invalido) {\n  return [{ json: { texto: 'Qual peça você tá procurando?', dados: { erro: entrada.motivo } } }];\n}\nif ($json.erro) {\n  return [{ json: { texto: 'Não consegui ver o estoque agora. Quer que eu chame um atendente?', dados: { erro: $json.erro } } }];\n}\nconst pecas = $json.pecas ?? [];\nif (!pecas.length) {\n  return [{ json: { texto: `Não tenho ${entrada.peca} em estoque no momento. Quer falar com um atendente pra encomendar?`, dados: { peca: entrada.peca, veiculo: entrada.veiculo, pecas: [] } } }];\n}\nconst linhas = pecas.map(p => `${p.nome}: ${p.quantidade} un., R$ ${Number(p.preco).toFixed(2).replace('.', ',')}`);\nreturn [{ json: { texto: `Tem sim! ${linhas.join('; ')}.`, dados: { peca: entrada.peca, veiculo: entrada.veiculo, pecas } } }];"
      }
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {
      "main": [
        [
          {
            "node": "Validar args",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validar args": {
      "main": [
        [
          {
            "node": "Args ok?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Args ok?": {
      "main": [
        [
          {
            "node": "Buscar estoque",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Retorno",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Buscar estoque": {
      "main": [
        [
          {
            "node": "Retorno",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
