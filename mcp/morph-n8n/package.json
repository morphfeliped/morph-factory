{
  "name": "morph-n8n",
  "version": "0.1.0",
  "description": "Servidor MCP da Fábrica Morph: cria subworkflows no n8n e configura a Meta (com modo simulação).",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "morph-n8n": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "validar": "node dist/validar-vertical.js",
    "test":"tsc -p tsconfig.json && node --test \"dist/**/*.test.js\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
